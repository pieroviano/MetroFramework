<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<VersionPrefix>$(MetroFrameworkVersion)</VersionPrefix>
		<SolutionDir Condition="'$(SolutionDir)'==''">$(MSBuildThisFileDirectory)</SolutionDir>
		<VersionSuffix>$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("000"))</VersionSuffix>
		<MinimalDirectoryNuGetProps>true</MinimalDirectoryNuGetProps>
	</PropertyGroup>
	<!-- NuGet package metadata, shared by every project that packs -->
	<PropertyGroup>
		<Title>MetroFramework Installer</Title>
		<Authors>Jens Thiel</Authors>
		<Copyright>Copyright (c) 2013 Jens Thiel</Copyright>
		<PackageProjectUrl>http://thielj.github.io/MetroFramework</PackageProjectUrl>
		<PackageIconUrl>http://thielj.github.io/MetroFramework/MetroFramework.png</PackageIconUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>See website for details.</PackageReleaseNotes>
		<PackageTags>Windows Forms Metro Framework UI MetroFramework ModernUI</PackageTags>
		<Description>Metro UI of Windows 8 for .NET Windows Forms applications.

Install this package to automatically pull in required dependencies.</Description>
	</PropertyGroup>
</Project>